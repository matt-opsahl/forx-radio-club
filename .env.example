# Copy to .env and fill in.
# First admin account, created only when the database is empty.
ADMIN_CALLSIGN=WA0JXT
ADMIN_NAME=Club Admin
# Leave blank to have a random password printed in `docker compose logs` on first start.
ADMIN_PASSWORD=

# Host port (container always listens on 8795)
FORX_PORT=8795

# Set to 1 when served over HTTPS (reverse proxy) so the login cookie is Secure.
COOKIE_SECURE=0

# Optional overrides
# CLUB_EMAIL=
# CLUB_TZ=America/Chicago
